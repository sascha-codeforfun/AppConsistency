<Window x:Class="AppConsistency.ReadmePickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Hue.Window}"
        Title="AppConsistency"
        Width="760" SizeToContent="Height" ResizeMode="CanResize" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="{DynamicResource Brush.Surface}" Padding="28,24">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Heading}" TextWrapping="Wrap"
                       Text="Choose which readmes to collect" />
            <TextBlock x:Name="BodyText" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <Border Background="{DynamicResource Brush.Base}"
                    BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}" Padding="14,12" Margin="0,18,0,0">
                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ListPanel" />
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True"
                        MinWidth="96" Margin="0,0,10,0" />
                <Button x:Name="ConfirmButton" Content="Collect README" Style="{StaticResource Hue.Button.Primary}"
                        MinWidth="96" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
