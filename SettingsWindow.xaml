<Window x:Class="AppConsistency.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Hue.Window}"
        Title="AppConsistency settings"
        Width="1000" Height="820" MinWidth="720" MinHeight="480" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <!-- An open padlock: the setting is in the file and can be edited. Icon.Lock is the closed one. -->
        <Geometry x:Key="Icon.Unlock">M4,7.5 L12,7.5 L12,13.5 L4,13.5 Z M5.5,7.5 L5.5,5.2 A2.5,2.5 0 0 1 10.4,4.4</Geometry>
    </Window.Resources>

    <Grid Background="{DynamicResource Brush.Base}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Brush.Chrome}" BorderBrush="{DynamicResource Brush.LineSoft}"
                BorderThickness="0,0,0,1" Padding="28,20">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource Text.Heading}" />
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="The standard every repo is checked against. A locked setting uses the built-in default and isn't in the file; unlock it to set your own. Switching an entry off keeps it in the file without effect, for a temporary change. The numbers come from the last scan, in memory." />
                <TextBlock x:Name="FileText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <ContentControl x:Name="ProblemPanel" Style="{StaticResource Hue.Callout.Warn}" Margin="0,12,0,0"
                                Visibility="Collapsed" HorizontalContentAlignment="Stretch">
                    <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                </ContentControl>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CardsPanel" Margin="28,20,28,8" />
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Chrome}" BorderBrush="{DynamicResource Brush.LineSoft}"
                BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,10,0" />
                <Button x:Name="SaveButton" Content="Save and rescan" Style="{StaticResource Hue.Button.Primary}"
                        MinWidth="128" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
