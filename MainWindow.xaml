<Window x:Class="AppConsistency.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AppConsistency.Ui"
        Style="{StaticResource Hue.Window}"
        Title="AppConsistency"
        Width="1180" Height="800" MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ui:PackageVisibilityConverter x:Key="PackageVisibility" />
        <ui:PackageTooltipConverter x:Key="PackageTooltip" />

        <!-- App-specific 16x16 stroke geometries, in the theme's icon idiom, for the three
             badges next to an app name. The theme's own set has no shield, flask or box. -->
        <Geometry x:Key="Icon.Shield">M8,1.7 L13.5,3.9 V8.2 C13.5,11.1 11.2,13.6 8,14.5 C4.8,13.6 2.5,11.1 2.5,8.2 V3.9 Z M5.8,8.1 L7.3,9.6 L10.2,6.7</Geometry>
        <Geometry x:Key="Icon.Flask">M6.3,1.9 H9.7 M6.9,1.9 V6.5 L3.5,12.3 C3.1,13 3.6,13.9 4.4,13.9 H11.6 C12.4,13.9 12.9,13 12.5,12.3 L9.1,6.5 V1.9 M5.3,10.1 H10.7</Geometry>
        <!-- The settings gear: eight teeth, a ring and a hub, drawn on a 24 x 24 grid and shown at 22 px.
             The theme's Icon.Settings reads as a sun at header size, so it isn't used here. -->
        <Geometry x:Key="Icon.Gear">M10.17,4.62 L10.33,1.94 L13.67,1.94 L13.83,4.62 A7.6,7.6 0 0 1 15.92,5.49 L17.93,3.70 L20.30,6.07 L18.51,8.08 A7.6,7.6 0 0 1 19.38,10.17 L22.06,10.33 L22.06,13.67 L19.38,13.83 A7.6,7.6 0 0 1 18.51,15.92 L20.30,17.93 L17.93,20.30 L15.92,18.51 A7.6,7.6 0 0 1 13.83,19.38 L13.67,22.06 L10.33,22.06 L10.17,19.38 A7.6,7.6 0 0 1 8.08,18.51 L6.07,20.30 L3.70,17.93 L5.49,15.92 A7.6,7.6 0 0 1 4.62,13.83 L1.94,13.67 L1.94,10.33 L4.62,10.17 A7.6,7.6 0 0 1 5.49,8.08 L3.70,6.07 L6.07,3.70 L8.08,5.49 A7.6,7.6 0 0 1 10.17,4.62 Z M15.2,12 A3.2,3.2 0 1 0 8.8,12 A3.2,3.2 0 1 0 15.2,12 Z</Geometry>
        <Geometry x:Key="Icon.Package">M8,1.8 L13.6,4.9 V11.1 L8,14.2 L2.4,11.1 V4.9 Z M2.4,4.9 L8,8 L13.6,4.9 M8,8 V14.2</Geometry>

        <!-- A quiet badge; the package one turns amber once something is off the approved list. -->
        <Style x:Key="Badge.Icon" TargetType="Path" BasedOn="{StaticResource Hue.Icon}">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Margin" Value="7,0,0,0" />
        </Style>
        <Style x:Key="Badge.Packages" TargetType="Path" BasedOn="{StaticResource Badge.Icon}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Packages}" Value="Foreign">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.WarnText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The dot beside an app in the list: the worst status it carries. Info is not a
             verdict, so it stays neutral grey. -->
        <Style x:Key="App.Marker" TargetType="ContentControl" BasedOn="{StaticResource Hue.Marker}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Stale}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Overall}" Value="Pass">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Overall}" Value="Warn">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Overall}" Value="Fail">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One finding's status pill. No Tag="Glow" anywhere: these repeat in a list. -->
        <Style x:Key="Row.Pill" TargetType="ContentControl" BasedOn="{StaticResource Hue.Pill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pass">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.OkText}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.OkEdge}" />
                </DataTrigger>
                <!-- License: indigo, the outlier colour. Not a verdict, so it never borrows a status colour. -->
                <DataTrigger Binding="{Binding Status}" Value="License">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.IndigoText}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.IndigoSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.IndigoEdge}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warn">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.WarnText}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarnEdge}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Fail">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.ErrorText}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.ErrorSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ErrorEdge}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A header pill that filters the app list. Same look as Hue.Pill; the code sets the
             colours from the count, and the active one gets a stronger edge and a glowing dot
             (one standalone pill at a time, so the glow is fine). -->
        <Style x:Key="Header.PillToggle" TargetType="ToggleButton">
            <Setter Property="Template" Value="{StaticResource Hue.PillTemplate}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- header  -->
            <RowDefinition Height="Auto" />  <!-- toolbar -->
            <RowDefinition Height="*" />     <!-- body    -->
            <RowDefinition Height="Auto" />  <!-- status  -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Hue.Header}">
            <!-- Left: icon and name. Middle: the scan's pills, dead centre. Right: version. -->
            <ui:HeaderPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Hue.IconGlow}" Width="64" Height="64">
                        <Image Source="pack://application:,,,/app_256.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </ContentControl>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AppConsistency" Style="{StaticResource Text.Title}" />
                        <TextBlock Text="Checks the newest snapshot of each app in your history folder against your build standards."
                                   Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Apps by worst status, then apps with a license to review (indigo, apart from the
                     verdicts). Hidden until a scan finishes; a zero count goes grey.
                     Click one to show only those apps in the list; click it again to show all. -->
                <StackPanel x:Name="SummaryPills" Orientation="Horizontal" Visibility="Collapsed"
                            AutomationProperties.Name="Scan summary">
                    <ToggleButton x:Name="PassPill" Style="{StaticResource Header.PillToggle}" Click="AppPill_Click"
                                  ToolTip="Show only apps where every check passes. Click again to show all." />
                    <ToggleButton x:Name="WarnPill" Style="{StaticResource Header.PillToggle}" Click="AppPill_Click" Margin="8,0,0,0"
                                  ToolTip="Show only apps with a warning. Click again to show all." />
                    <ToggleButton x:Name="FailPill" Style="{StaticResource Header.PillToggle}" Click="AppPill_Click" Margin="8,0,0,0"
                                  ToolTip="Show only apps with a failing check. Click again to show all." />
                    <ToggleButton x:Name="LicensePill" Style="{StaticResource Header.PillToggle}" Click="AppPill_Click" Margin="8,0,0,0"
                                  ToolTip="Show only apps that aren't on the standard MIT license: no license file, another license, or MIT that isn't standard. Click again to show all." />
                </StackPanel>

                <!-- Right: the settings gear, then version, SDK, runtime and which standard is in use. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Width="44" Height="34" Padding="0" Margin="0,0,20,0"
                            VerticalAlignment="Center" Click="Settings_Click"
                            ToolTip="Settings: the standard every repo is checked against"
                            AutomationProperties.Name="Settings">
                        <Path Style="{StaticResource Hue.Icon}" Data="{StaticResource Icon.Gear}"
                              Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock x:Name="SdkText" HorizontalAlignment="Right" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                        <TextBlock x:Name="RuntimeText" HorizontalAlignment="Right" Style="{StaticResource Text.Caption}" />
                        <TextBlock x:Name="StandardText" HorizontalAlignment="Right" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </StackPanel>
            </ui:HeaderPanel>
        </Border>

        <!-- The folder to scan, and what can be done with a whole scan. -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- The path takes whatever is left, so it shortens first on small windows. -->
                <TextBox x:Name="PathBox" KeyDown="PathBox_KeyDown" MinWidth="160"
                         AutomationProperties.Name="History folder"
                         ToolTip="History folder with one subfolder per app, or a single app's folder" />
                <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Margin="10,0,0,0" Click="Browse_Click" />
                <Button x:Name="CopyButton" Grid.Column="2" Content="Copy report" Margin="10,0,0,0"
                        IsEnabled="False" Click="Copy_Click"
                        ToolTip="Copies every warning and failure across all apps as plain text" />
                <Button x:Name="BackupAllButton" Grid.Column="3" Content="BACKUP all" Margin="10,0,0,0"
                        Style="{StaticResource Hue.Button.Indigo}" IsEnabled="False" Click="BackupAll_Click"
                        ToolTip="Writes one zip to Downloads holding the newest snapshot of every app, each without its version number. Everything inside is dated today at 00:00:00" />
                <!-- Plain grey for now; the colour is still to be decided. -->
                <Button x:Name="CollectReadmeButton" Grid.Column="4" Content="Collect README" Margin="10,0,0,0"
                        IsEnabled="False" Click="CollectReadme_Click"
                        ToolTip="Writes one zip to Downloads holding the readmes and license files from the newest snapshot of every app, one folder per app, dated today at 00:00:00" />
                <Button x:Name="ScanButton" Grid.Column="5" Content="Scan" Margin="10,0,0,0" MinWidth="96"
                        Style="{StaticResource Hue.Button.Primary}" Click="Scan_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="AppList" SelectionChanged="AppList_SelectionChanged"
                     AutomationProperties.Name="Apps">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource App.Marker}" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <!-- The app's own version from its csproj; empty when it sets none. -->
                            <TextBlock Grid.Column="2" Text="{Binding AppVersion}" Margin="8,0,0,0" VerticalAlignment="Top"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <Path Data="{StaticResource Icon.Shield}" Style="{StaticResource Badge.Icon}"
                                          ToolTip="Asks for admin rights"
                                          Visibility="{Binding Elevated, Converter={StaticResource BoolToVisibility}}" />
                                    <Path Data="{StaticResource Icon.Flask}" Style="{StaticResource Badge.Icon}"
                                          ToolTip="Has a test project"
                                          Visibility="{Binding HasTests, Converter={StaticResource BoolToVisibility}}" />
                                    <Path Data="{StaticResource Icon.Package}" Style="{StaticResource Badge.Packages}"
                                          ToolTip="{Binding Packages, Converter={StaticResource PackageTooltip}}"
                                          Visibility="{Binding Packages, Converter={StaticResource PackageVisibility}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="2" Style="{StaticResource Hue.Card}">
                <Grid>
                    <TextBlock x:Name="EmptyText" Text="Choose your history folder to start."
                               Style="{StaticResource Text.Body}" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" />

                    <Grid x:Name="DetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <!-- What kind of app this is: categories, so tags with words, not status pills. -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="DetailName" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DetailVersion" Style="{StaticResource Text.Heading}" VerticalAlignment="Center"
                                               Margin="10,0,0,0" Foreground="{DynamicResource Brush.TextDim}" />
                                    <ContentControl x:Name="AdminBadge" Style="{StaticResource Hue.Tag}"
                                                    Margin="12,0,0,0" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Hue.Icon}" Data="{StaticResource Icon.Shield}" />
                                            <TextBlock Text="Admin rights" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ContentControl>
                                    <ContentControl x:Name="TestsBadge" Style="{StaticResource Hue.Tag}"
                                                    Margin="6,0,0,0" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Hue.Icon}" Data="{StaticResource Icon.Flask}" />
                                            <TextBlock Text="Tests" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ContentControl>
                                    <Button x:Name="PackagesBadgeButton" Style="{StaticResource Hue.Button.Ghost}"
                                            Margin="6,0,0,0" MinWidth="188" Visibility="Collapsed"
                                            Click="Packages_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="PackagesBadge" Style="{StaticResource Hue.Icon}"
                                                  Data="{StaticResource Icon.Package}" />
                                            <TextBlock x:Name="PackagesBadgeText" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="DetailSource" Style="{StaticResource Text.Caption}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                <TextBlock x:Name="DetailSummary" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ApplyButton" Style="{StaticResource Hue.Button.Tonal}" Margin="0,0,8,0"
                                            MinWidth="128" Visibility="Collapsed" Click="Apply_Click"
                                            ToolTip="Stages one copy to Downloads with every queued fix applied, dated the release day at 00:00:00" />
                                    <Button x:Name="CopyFindingsButton" Content="Copy findings" Margin="0,0,8,0"
                                            Click="CopyFindings_Click"
                                            ToolTip="Copies this app's findings as text, as currently filtered" />
                                    <Button x:Name="StageButton" Content="Stage to Downloads" Click="Stage_Click"
                                            ToolTip="Copies the newest snapshot to Downloads without its version number, every file dated the release day at 00:00:00. With private files (set in Settings) it asks: keep them, or leave them out for publishing" />
                                    <Button x:Name="RevealButton" Content="Show in Explorer" Margin="8,0,0,0"
                                            Style="{StaticResource Hue.Button.Ghost}" Click="Reveal_Click" />
                                </StackPanel>
                                <!-- The day Stage and Apply date every file with, always at 00:00:00. -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <TextBlock Text="Release date" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    <TextBox x:Name="ReleaseDateBox" Width="112" Margin="10,0,0,0" TextChanged="ReleaseDate_TextChanged"
                                             AutomationProperties.Name="Release date"
                                             ToolTip="Stage and Apply date every file in the copy on this day at 00:00:00. Format yyyy-MM-dd." />
                                    <TextBlock Text="00:00:00" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Click a count to show only that kind; click it again to show all.
                             Good to bad, left to right, like the header. The words differ on purpose: the header
                             counts apps across the scan, these count this app's checks. -->
                        <WrapPanel Grid.Row="1" Margin="0,16,0,0">
                            <ToggleButton x:Name="FilterAll" Margin="0,0,8,0" Click="Filter_Click"
                                          ToolTip="Show all findings." />
                            <ToggleButton x:Name="FilterPass" Tag="Pass" Margin="0,0,8,0" Click="Filter_Click"
                                          ToolTip="Show only checks that pass. Click again to show all.">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Hue.Marker}" Foreground="{DynamicResource Brush.Ok}" />
                                    <TextBlock x:Name="FilterPassText" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="FilterInfo" Tag="Info" Margin="0,0,8,0" Click="Filter_Click"
                                          ToolTip="Show only informational findings. Click again to show all.">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Hue.Marker}" Foreground="{DynamicResource Brush.Stale}" />
                                    <TextBlock x:Name="FilterInfoText" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="FilterLicense" Tag="License" Margin="0,0,8,0" Click="Filter_Click"
                                          ToolTip="Show only the license finding. Click again to show all.">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Hue.Marker}" Foreground="{DynamicResource Brush.Indigo}" />
                                    <TextBlock x:Name="FilterLicenseText" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="FilterWarn" Tag="Warn" Margin="0,0,8,0" Click="Filter_Click"
                                          ToolTip="Show only findings to review. Click again to show all.">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Hue.Marker}" Foreground="{DynamicResource Brush.Warn}" />
                                    <TextBlock x:Name="FilterWarnText" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="FilterFail" Tag="Fail" Click="Filter_Click"
                                          ToolTip="Show only findings that need attention. Click again to show all.">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Hue.Marker}" Foreground="{DynamicResource Brush.Error}" />
                                    <TextBlock x:Name="FilterFailText" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </WrapPanel>

                        <!-- What the last Stage or Fix did, or why an action stopped. -->
                        <ContentControl x:Name="NoticePanel" Grid.Row="2" Visibility="Collapsed" Margin="0,16,0,0"
                                        Style="{StaticResource Hue.Callout.Ok}" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text}" />
                                <Button x:Name="NoticeButton" Grid.Column="1" Content="Show in Explorer" Margin="16,0,0,0"
                                        Click="NoticeReveal_Click" />
                            </Grid>
                        </ContentControl>

                        <Grid Grid.Row="3" Margin="0,18,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="CheckGroups">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,10,14">
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource Text.Section}"
                                                           Margin="2,0,0,8" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource Brush.Raised}"
                                                                    BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="1"
                                                                    CornerRadius="{StaticResource Radius.Item}"
                                                                    Padding="12,10" Margin="0,0,0,6">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="80" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <ContentControl Style="{StaticResource Row.Pill}"
                                                                                    Content="{Binding StatusWord}"
                                                                                    VerticalAlignment="Top" Margin="0,1,0,0" />
                                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                        <TextBlock Text="{Binding Rule}" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource Brush.Text}" />
                                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Body}"
                                                                                   Margin="0,3,0,0" />
                                                                    </StackPanel>
                                                                    <ToggleButton Grid.Column="2" Content="{Binding FixLabel}"
                                                                                  IsChecked="{Binding IsQueued, Mode=TwoWay}"
                                                                                  Margin="14,0,0,0" MinWidth="86" Padding="12,0"
                                                                                  VerticalAlignment="Center" Click="Fix_Click"
                                                                                  Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}"
                                                                                  ToolTip="Adds this fix to the queue, or takes it out again" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="AllPassText" Visibility="Collapsed" Style="{StaticResource Text.Body}"
                                       FontSize="15" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Hue.StatusBar}">
            <StackPanel Orientation="Horizontal">
                <ContentControl x:Name="StatusDot" Style="{StaticResource Hue.Marker}"
                                Foreground="{DynamicResource Brush.Stale}" />
                <TextBlock x:Name="StatusText" Margin="9,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
