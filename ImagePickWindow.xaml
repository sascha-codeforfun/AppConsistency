<Window x:Class="AppConsistency.ImagePickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Hue.Window}"
        Title="AppConsistency"
        Width="1240" Height="800" MinWidth="960" MinHeight="520" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- The thumbnail is a button so it takes a click, Enter and Space, and shows focus. -->
        <ControlTemplate x:Key="ThumbTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Item}" Padding="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentLight}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Border Background="{DynamicResource Brush.Surface}" Padding="28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Heading}" TextWrapping="Wrap" />
            <TextBlock x:Name="BodyText" Grid.Row="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock x:Name="SettingsText" Grid.Row="2" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" MinWidth="420" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="4*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="FileList" Background="{DynamicResource Brush.Base}" Padding="6"
                         SelectionMode="Single" IsTextSearchEnabled="False" KeyboardNavigation.TabNavigation="Continue"
                         SelectionChanged="FileList_SelectionChanged" PreviewKeyDown="FileList_PreviewKeyDown" />

                <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" Background="Transparent"
                              ResizeBehavior="PreviousAndNext" Focusable="False" Cursor="SizeWE" />

                <Border Grid.Column="2" Background="{DynamicResource Brush.Base}"
                        BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}" Padding="16,14">
                    <DockPanel x:Name="PreviewPane">
                        <ScrollViewer DockPanel.Dock="Top" MaxHeight="340" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <TextBlock x:Name="PreviewTitle" Style="{StaticResource Text.Mono}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                            <TextBlock x:Name="PreviewFacts" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource Text.Section}" Text="METADATA" Margin="0,12,0,3" />
                            <TextBlock x:Name="MetadataText" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource Text.Section}" Text="AT THIS LEVEL" Margin="0,10,0,3" />
                            <TextBlock x:Name="ResultText" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />

                            <StackPanel x:Name="PalettePanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock x:Name="PaletteText" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                <CheckBox x:Name="UsePaletteBox" Content="Use the palette for this file" Margin="0,8,0,0"
                                          Click="UsePalette_Click" />
                            </StackPanel>

                            <StackPanel x:Name="ViewPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                                <ToggleButton x:Name="ViewOriginal" Content="Original" Click="View_Click" Tag="Original" Margin="0,0,8,0" />
                                <ToggleButton x:Name="ViewPalette" Content="Palette" Click="View_Click" Tag="Palette" Margin="0,0,8,0" />
                                <ToggleButton x:Name="ViewDifference" Content="Difference" Click="View_Click" Tag="Difference" />
                            </StackPanel>
                            <TextBlock x:Name="ViewNote" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

                            <Border Height="1" Background="{DynamicResource Brush.LineSoft}" Margin="0,10,0,10" />
                        </StackPanel>
                        </ScrollViewer>

                        <Grid>
                            <Button x:Name="ThumbButton" Template="{StaticResource ThumbTemplate}" Cursor="Hand"
                                    ToolTip="Open at full size" Click="Thumb_Click" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Image x:Name="ThumbImage" Stretch="Uniform" StretchDirection="Both"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Button>
                            <TextBlock x:Name="PreviewMessage" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TickAllButton" Content="Tick all to do" Style="{StaticResource Hue.Button.Ghost}"
                            Click="TickAll_Click" Margin="0,0,8,0" />
                    <Button x:Name="UntickAllButton" Content="Untick all" Style="{StaticResource Hue.Button.Ghost}"
                            Click="UntickAll_Click" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    <CheckBox x:Name="RememberBox" Content="Remember changed levels in Settings" IsChecked="True" Margin="0,6,0,0"
                              IsEnabled="False" Click="Remember_Click" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True"
                            MinWidth="96" Margin="0,0,10,0" />
                    <Button x:Name="ConfirmButton" Content="Queue changes" Style="{StaticResource Hue.Button.Primary}"
                            MinWidth="120" IsEnabled="False" Click="Confirm_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
