<Window x:Class="AppConsistency.ImageZoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Hue.Window}"
        Title="AppConsistency"
        Width="1100" Height="800" MinWidth="500" MinHeight="400" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="OnKeyDown">
    <Grid Background="{DynamicResource Brush.Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="16,10" Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="ZoomLabel" DockPanel.Dock="Right" Style="{StaticResource Text.Mono}"
                               VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="52" TextAlignment="Right" />
                    <Slider x:Name="ZoomSlider" DockPanel.Dock="Right" Width="220" Minimum="0.05" Maximum="8" Value="1"
                            VerticalAlignment="Center" ValueChanged="OnZoomChanged" Focusable="False" />
                    <TextBlock x:Name="NameText" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.Text}"
                               VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Text="Ctrl+wheel or + / − to zoom, 0 to fit, 1 for 100 %, Esc to close" />
            </StackPanel>
        </Border>
        <!-- White behind the picture: diagrams and screenshots with transparent parts are drawn for a white page. -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="White" PreviewMouseWheel="OnMouseWheel">
            <Image x:Name="Picture" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.LayoutTransform>
                    <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                </Image.LayoutTransform>
            </Image>
        </ScrollViewer>
    </Grid>
</Window>
